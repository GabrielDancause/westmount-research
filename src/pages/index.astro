---
import BaseHead from '../layouts/BaseHead.astro';
import Nav from '../components/Nav.astro';

// All pages from public/ — properly categorized, no duplicates
const tools = [
  { emoji: "🇨🇦", title: "RRSP Contribution Limit & Deduction Calculator (2026)", subtitle: "contribution limits · tax savings", slug: "/rrsp-contribution-limit-2026", stat: "$32,490", statLabel: "max 2026 limit", desc: "Calculate your 2026 RRSP room based on income. See exact deduction limits and potential tax savings.", tag: "TOOL" },
  { title: "Portfolio Rebalancing Tool", subtitle: "rebalancing · asset allocation", slug: "/portfolio-rebalancer.html", stat: "Target %", statLabel: "rebalance your portfolio", desc: "Enter your current holdings and target allocation to calculate exactly what to buy and sell.", tag: "TOOL" },
  { title: "Margin & Leverage Calculator", subtitle: "margin call · buying power · leverage", slug: "/margin-calculator.html", stat: "Interactive", statLabel: "margin risk simulator", desc: "Calculate buying power, maintenance margin, and exact margin call price. Simulate leveraged returns.", tag: "TOOL" },
  { title: "Compound Interest Calculator", subtitle: "savings · growth · projections", slug: "/compound-interest-calculator.html", stat: "Interactive", statLabel: "compound growth simulator", desc: "Project how your investments grow over time with compound interest. Adjust rate, contributions, and timeline.", tag: "TOOL" },
  { title: "Dividend Reinvestment Calculator (DRIP)", subtitle: "dividends · reinvestment · compounding", slug: "/dividend-reinvestment-calculator.html", stat: "Interactive", statLabel: "DRIP growth projector", desc: "See how reinvesting dividends accelerates portfolio growth over 5, 10, or 30 years.", tag: "TOOL" },
  { title: "FIRE Retirement Calculator", subtitle: "financial independence · early retirement", slug: "/fire-retirement-calculator.html", stat: "Interactive", statLabel: "FIRE number calculator", desc: "Calculate your FIRE number, savings rate, and projected retirement date based on expenses and income.", tag: "TOOL" },
  { title: "Portfolio Risk Calculator", subtitle: "risk · volatility · correlation", slug: "/portfolio-risk-calculator.html", stat: "Interactive", statLabel: "risk analysis tool", desc: "Analyze portfolio risk, expected volatility, and diversification score across your holdings.", tag: "TOOL" },
  { title: "Market Sector Analysis Dashboard", subtitle: "sectors · performance · comparison", slug: "/market-sector-analysis-dashboard.html", stat: "11", statLabel: "GICS sectors tracked", desc: "Interactive dashboard comparing all 11 GICS sectors by performance, valuation, and momentum.", tag: "TOOL" },
];

const studies = [
  { title: "Dividend Aristocrats Analysis 2026", subtitle: "yield · payout · growth rankings", slug: "/dividend-aristocrats-analysis-2026.html", stat: "68", statLabel: "companies with 25+ yr streaks", desc: "S&P 500 Dividend Aristocrats ranked by yield, payout ratio, valuation, and growth.", tag: "ORIGINAL RESEARCH" },
  { title: "IPO Performance Tracker 2024–2026", subtitle: "50 items · first-year returns", slug: "/ipo-performance.html", stat: "50", statLabel: "recent IPOs tracked", desc: "How do newly listed stocks perform? IPO price, first-day pop, and 1-year return analysis.", tag: "ORIGINAL RESEARCH" },
  { title: "Insider Trading Tracker 2026", subtitle: "200 items · insider buys & sells", slug: "/insider-trading.html", stat: "$148M", statLabel: "highest insider buy value", desc: "200 recent open-market trades by corporate executives. Who's buying their own stock?", tag: "ORIGINAL RESEARCH" },
  { title: "Equity Risk Premium: Stock vs Bond Yield 2026", subtitle: "S&P 500 vs 10-Year Treasury", slug: "/equity-risk-premium.html", stat: "-0.70%", statLabel: "current equity risk premium", desc: "S&P 500 earnings yield vs Treasury yield. Is the stock market fairly valued in 2026?", tag: "ORIGINAL RESEARCH" },
  { title: "Debt-to-Equity Rankings 2026", subtitle: "485 items · most leveraged", slug: "/debt-to-equity.html", stat: "91.9", statLabel: "highest D/E ratio (CLX)", desc: "485 S&P 500 companies ranked by leverage. See which hold negative equity.", tag: "ORIGINAL RESEARCH" },
  { title: "Revenue Per Employee Rankings 2026", subtitle: "130 items · operational efficiency", slug: "/revenue-per-employee.html", stat: "$7.29M", statLabel: "highest revenue per employee", desc: "S&P 500 companies ranked by operational efficiency. Devon Energy leads at $7.29M/employee.", tag: "ORIGINAL RESEARCH" },
  { title: "S&P 500 Market Cap Concentration 2026", subtitle: "weight rankings · concentration analysis", slug: "/market-concentration.html", stat: "37.3%", statLabel: "of S&P 500 in just 10 stocks", desc: "Top 10 stocks control 37.3% of the index. Full weight rankings & concentration trends.", tag: "ORIGINAL RESEARCH" },
  { title: "Online Broker Fee Comparison 2026", subtitle: "22 brokers · commissions · margin rates", slug: "/broker-fees.html", stat: "22", statLabel: "brokers compared", desc: "Compare commissions, options fees, and margin rates across 22 US/Canada brokers.", tag: "ORIGINAL RESEARCH" },
  { title: "ETF Expense Ratio Index 2026", subtitle: "86 ETFs ranked by cost", slug: "/etf-expense-ratios.html", stat: "86", statLabel: "ETFs ranked by expense ratio", desc: "VOO vs SPY vs IVV and 83 more compared by true cost. Which ETF is cheapest?", tag: "ORIGINAL RESEARCH" },
  { title: "Sector P/E Ratios 2026", subtitle: "11 GICS sectors vs historical average", slug: "/sector-pe-ratios.html", stat: "11", statLabel: "GICS sectors analyzed", desc: "All 11 GICS sectors vs 10-year historical average. Which sectors are overvalued?", tag: "ORIGINAL RESEARCH" },
  { title: "Most Shorted Stocks 2026", subtitle: "76 stocks · 20%+ short interest", slug: "/short-interest.html", stat: "76", statLabel: "heavily shorted stocks ranked", desc: "Stocks with 20%+ short interest ranked by % of float. Squeeze candidates & bearish bets.", tag: "ORIGINAL RESEARCH" },
  { title: "Stock Buyback Leaders 2026", subtitle: "106 companies · repurchase volume", slug: "/buyback-leaders.html", stat: "$709.5B", statLabel: "in annual buybacks tracked", desc: "Companies ranked by share repurchase volume, buyback yield & share count reduction.", tag: "ORIGINAL RESEARCH" },
  { title: "Beta & Volatility Rankings 2026", subtitle: "S&P 500 risk analysis", slug: "/beta-volatility.html", stat: "β", statLabel: "risk-adjusted rankings", desc: "S&P 500 stocks ranked by beta and volatility. Find the most and least volatile names.", tag: "ORIGINAL RESEARCH" },
  { title: "CEO Compensation vs Stock Performance 2026", subtitle: "executive pay · shareholder returns", slug: "/ceo-compensation.html", stat: "$$$", statLabel: "pay vs performance gap", desc: "Are the highest-paid CEOs delivering the best returns? Compensation vs stock performance analysis.", tag: "ORIGINAL RESEARCH" },
  { title: "Dividend Payout Ratio Analysis 2026", subtitle: "sustainability · coverage", slug: "/dividend-payout-ratios.html", stat: "%", statLabel: "payout sustainability ranked", desc: "Which companies can sustain their dividends? Payout ratios ranked across the S&P 500.", tag: "ORIGINAL RESEARCH" },
  { title: "Dividend Yield vs Growth Rate 2026", subtitle: "income vs appreciation", slug: "/dividend-yield-vs-growth.html", stat: "vs", statLabel: "yield vs growth analysis", desc: "High yield or high growth? Analysis of which dividend strategy delivers better total returns.", tag: "ORIGINAL RESEARCH" },
  { title: "EV/EBITDA by Sector 2026", subtitle: "enterprise value multiples", slug: "/ev-ebitda-sectors.html", stat: "11x", statLabel: "median EV/EBITDA", desc: "Enterprise value multiples across all GICS sectors. Find undervalued sectors by EV/EBITDA.", tag: "ORIGINAL RESEARCH" },
  { title: "Free Cash Flow Yield: Top 50 S&P 500 2026", subtitle: "cash generation · value screen", slug: "/free-cash-flow-yield.html", stat: "50", statLabel: "highest FCF yield stocks", desc: "Top 50 S&P 500 companies by free cash flow yield. The best cash-generating machines.", tag: "ORIGINAL RESEARCH" },
  { title: "Institutional Ownership Rankings 2026", subtitle: "most & least owned stocks", slug: "/institutional-ownership.html", stat: "%", statLabel: "institutional ownership ranked", desc: "Which stocks do institutions love (or avoid)? Ownership concentration analysis.", tag: "ORIGINAL RESEARCH" },
  { title: "Price-to-Book Ratio by Sector 2026", subtitle: "valuation · asset-based", slug: "/price-to-book.html", stat: "P/B", statLabel: "sector valuations ranked", desc: "Price-to-book ratios across sectors. Where are you paying the most (or least) for assets?", tag: "ORIGINAL RESEARCH" },
  { title: "Return on Equity Rankings 2026", subtitle: "profitability · efficiency", slug: "/roe-rankings.html", stat: "ROE", statLabel: "most efficient companies", desc: "S&P 500 companies ranked by return on equity. The most capital-efficient businesses.", tag: "ORIGINAL RESEARCH" },
  { title: "S&P 500 PEG Ratio Rankings 2026", subtitle: "growth-adjusted valuations", slug: "/sp500-peg-ratios.html", stat: "PEG", statLabel: "growth-adjusted P/E", desc: "PEG ratios for S&P 500 stocks. Find companies where growth justifies the price.", tag: "ORIGINAL RESEARCH" },
  { title: "S&P 500 Sector Weights: 25-Year Rotation", subtitle: "2000–2026 · sector evolution", slug: "/sp500-sector-weights.html", stat: "25yr", statLabel: "of sector weight shifts", desc: "How sector weights in the S&P 500 have shifted from 2000 to 2026. Tech's rise, Energy's fall.", tag: "ORIGINAL RESEARCH" },
  { title: "Stock Split History & Post-Split Performance", subtitle: "2020–2026 · split returns", slug: "/stock-splits-history.html", stat: "📊", statLabel: "post-split performance tracked", desc: "Do stock splits boost returns? Historical analysis of splits and their 1-year post-split performance.", tag: "ORIGINAL RESEARCH" },
  { title: "Working Capital Efficiency Rankings 2026", subtitle: "liquidity · operational efficiency", slug: "/working-capital.html", stat: "WC", statLabel: "efficiency rankings", desc: "Which companies manage cash most efficiently? Working capital rankings across the S&P 500.", tag: "ORIGINAL RESEARCH" },
  { title: "Bond ETF Expense Ratio Comparison 2026", subtitle: "BND · AGG · IUSB · SCHZ", slug: "/bond-etf-expense-ratio-comparison.html", stat: "20+", statLabel: "bond ETFs compared", desc: "Which bond ETF actually has the lowest fees? Side-by-side comparison with cost calculator.", tag: "ORIGINAL RESEARCH" },
  { title: "Lowest Expense Ratio ETFs 2026", subtitle: "by category · cheapest funds", slug: "/lowest-expense-ratio-etfs-2026.html", stat: "0.03%", statLabel: "cheapest ETF found", desc: "The rock-bottom cheapest ETFs in every category — some charge almost nothing.", tag: "ORIGINAL RESEARCH" },
  { title: "Most Expensive ETFs 2026", subtitle: "highest fees · cheaper alternatives", slug: "/highest-expense-ratio-etfs-2026.html", stat: "50+", statLabel: "overpriced ETFs ranked", desc: "These ETFs charge 10-30x more than alternatives. Are any worth the premium?", tag: "ORIGINAL RESEARCH" },
  { title: "Average ETF Expense Ratio 2026", subtitle: "benchmarks · percentiles", slug: "/average-etf-expense-ratio-2026.html", stat: "100+", statLabel: "ETFs analyzed", desc: "How does your ETF's expense ratio compare? Interactive percentile calculator.", tag: "ORIGINAL RESEARCH" },
  { title: "Short Squeeze Candidates March 2026", subtitle: "high short interest · squeeze probability", slug: "/short-squeeze-candidates-march-2026.html", stat: "🎯", statLabel: "squeeze probability ranked", desc: "Stocks with the highest squeeze potential right now — ranked by short interest, days to cover, and float.", tag: "ORIGINAL RESEARCH" },
  { title: "Most Shorted Stocks March 2026", subtitle: "monthly rankings · short % of float", slug: "/most-shorted-stocks-march-2026.html", stat: "100", statLabel: "stocks ranked by short interest", desc: "The complete March 2026 short interest rankings. Which stocks are bears piling into?", tag: "ORIGINAL RESEARCH" },
  { title: "Largest Stock Buybacks 2026", subtitle: "repurchase tracker · billions ranked", slug: "/largest-stock-buybacks-2026.html", stat: "$B", statLabel: "in buybacks tracked", desc: "Which companies are buying back the most stock? Full buyback tracker with yield comparison.", tag: "ORIGINAL RESEARCH" },
  { title: "Average Institutional Ownership 2026", subtitle: "by market cap · by sector", slug: "/average-institutional-ownership-2026.html", stat: "%", statLabel: "avg institutional ownership", desc: "How much of the stock market do institutions own? Breakdown by cap size and sector.", tag: "ORIGINAL RESEARCH" },
  { title: "Dividend Aristocrats Complete List March 2026", subtitle: "every aristocrat · yield · streaks", slug: "/dividend-aristocrats-complete-list-2026.html", stat: "67", statLabel: "aristocrats listed", desc: "The full list of every S&P 500 Dividend Aristocrat with yield, growth rate, and consecutive years.", tag: "ORIGINAL RESEARCH" },
];

const guides = [
  { title: "The Complete Guide to ETF Investing", subtitle: "educational · asset allocation", slug: "/guide-etf-investing.html", stat: "15", statLabel: "minute read", desc: "Learn what ETFs are, types, key metrics like expense ratios, tax efficiency, and how to build a portfolio.", tag: "GUIDE" },
  { title: "Value Investing Fundamentals", subtitle: "Graham to Buffett · portfolio construction", slug: "/guide-value-investing.html", stat: "8", statLabel: "core concepts covered", desc: "From Benjamin Graham's margin of safety to Buffett's evolution. Build a value investing framework.", tag: "GUIDE" },
  { title: "ETF vs Index Funds Comparison", subtitle: "cost · tax · structure differences", slug: "/etf-vs-index-funds-guide.html", stat: "vs", statLabel: "ETF vs index fund", desc: "What's the real difference between ETFs and index mutual funds? Cost, tax, and structure compared.", tag: "GUIDE" },
  { title: "Understanding Bond Ratings & Fixed Income", subtitle: "credit quality · yield curves", slug: "/guide-bond-ratings.html", stat: "AAA→D", statLabel: "rating scale explained", desc: "How bond ratings work, what they mean for investors, and how to evaluate fixed income risk.", tag: "GUIDE" },
  { title: "Options Trading for Beginners", subtitle: "calls · puts · strategies", slug: "/guide-options-basics.html", stat: "101", statLabel: "options concepts explained", desc: "A complete guide to options trading. Calls, puts, greeks, basic strategies, and risk management.", tag: "GUIDE" },
  { title: "How to Read Financial Statements", subtitle: "income statement · balance sheet · cash flow", slug: "/guide-reading-financial-statements.html", stat: "3", statLabel: "core statements explained", desc: "Learn to read income statements, balance sheets, and cash flow statements like a pro investor.", tag: "GUIDE" },
  { title: "How to Build a Dividend Portfolio", subtitle: "screening · construction · DRIP", slug: "/guide-dividend-portfolio.html", stat: "9", statLabel: "steps to build income", desc: "A step-by-step framework for building a dividend portfolio. Screening, traps to avoid, and sample allocations.", tag: "GUIDE" },
  { title: "Understanding Market Cycles", subtitle: "expansion · peak · contraction · trough", slug: "/guide-market-cycles.html", stat: "4", statLabel: "phases decoded", desc: "The hidden indicators that signal where we are in the cycle — and how to position your portfolio for each phase.", tag: "GUIDE" },
  { title: "Technical Analysis for Fundamental Investors", subtitle: "what works · what doesn't", slug: "/guide-technical-analysis-basics.html", stat: "6", statLabel: "evidence-backed signals", desc: "A skeptical value investor's honest take on which chart signals actually work and which to ignore.", tag: "GUIDE" },
  { title: "How ETF Expense Ratios Work", subtitle: "fees · NAV deduction · cost calculator", slug: "/guide-how-etf-expense-ratios-work.html", stat: "💰", statLabel: "the hidden fee explained", desc: "You're paying ETF fees every day and never see a bill. Here's exactly how expense ratios silently eat your returns.", tag: "GUIDE" },
];

const lists = [];
---
<html lang="en">
<head>
  <BaseHead />
  <title>Westmount Fundamentals — Independent Equity Research</title>
  <meta name="description" content="Independent equity research. PEG ratios, dividend analysis, broker comparisons, and sector valuations — data-driven, no fluff." />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: 'Inter', -apple-system, sans-serif; 
      background: #060a12; 
      color: #c8d0de; 
      line-height: 1.6;
    }

    /* Hero */
    .hero { 
      text-align: center; 
      padding: 100px 24px 70px; 
      background: linear-gradient(180deg, #0a1628 0%, #060a12 100%); 
      position: relative; 
    }
    .hero::before { 
      content: ''; 
      position: absolute; 
      inset: 0; 
      background: radial-gradient(circle at 50% 40%, rgba(74,143,231,0.08) 0%, transparent 60%); 
    }
    .hero-content { position: relative; z-index: 1; }
    .hero .tagline { 
      color: #4a8fe7; 
      font-size: 0.85rem; 
      font-weight: 700; 
      letter-spacing: 3px; 
      text-transform: uppercase; 
      margin-bottom: 16px; 
    }
    .hero h1 { 
      font-size: 3rem; 
      font-weight: 900; 
      letter-spacing: -1.5px; 
      margin-bottom: 20px; 
      color: #fff; 
    }
    .hero p { 
      color: #5a6a80; 
      font-size: 1.05rem; 
      max-width: 520px; 
      margin: 0 auto; 
    }

    /* Sections */
    .section-container { 
      max-width: 1200px; 
      margin: 0 auto; 
      padding: 60px 24px; 
    }
    .section-header { 
      text-align: center; 
      margin-bottom: 40px; 
    }
    .section-tag { 
      display: inline-block; 
      background: rgba(74,143,231,0.1); 
      color: #4a8fe7; 
      font-size: 0.7rem; 
      font-weight: 800; 
      padding: 6px 16px; 
      border-radius: 20px; 
      letter-spacing: 1px; 
      margin-bottom: 12px; 
    }
    .section-title { 
      font-size: 2.2rem; 
      font-weight: 900; 
      color: #fff; 
      margin-bottom: 8px; 
      letter-spacing: -0.8px; 
    }
    .section-sub { 
      color: #5a6a80; 
      font-size: 1rem; 
    }

    /* Studies Grid */
    .studies-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); 
      gap: 24px; 
    }
    .study-card { 
      background: linear-gradient(135deg, #0a1020 0%, #0d1428 100%); 
      border: 1px solid #1a2332; 
      border-radius: 16px; 
      padding: 32px 28px; 
      text-decoration: none; 
      color: inherit; 
      display: block; 
      transition: all 0.3s ease; 
      position: relative; 
      overflow: hidden; 
    }
    .study-card::before { 
      content: ''; 
      position: absolute; 
      top: 0; 
      left: 0; 
      right: 0; 
      height: 2px; 
      background: linear-gradient(90deg, #4a8fe7, #6ba3f0); 
      opacity: 0; 
      transition: opacity 0.3s; 
    }
    .study-card:hover { 
      border-color: #4a8fe7; 
      transform: translateY(-4px); 
      box-shadow: 0 12px 40px rgba(74,143,231,0.15); 
    }
    .study-card:hover::before { opacity: 1; }
    
    .study-emoji { 
      font-size: 1.8rem; 
      margin-bottom: 16px; 
      display: block; 
    }
    .study-stat { 
      margin-bottom: 16px; 
    }
    .stat-number { 
      display: block; 
      font-size: 2.4rem; 
      font-weight: 900; 
      color: #4a8fe7; 
      line-height: 1; 
      letter-spacing: -1px; 
    }
    .stat-label { 
      display: block; 
      font-size: 0.8rem; 
      color: #5a6a80; 
      margin-top: 4px; 
    }
    .study-name { 
      font-size: 1.1rem; 
      font-weight: 800; 
      color: #e0e8f0; 
      margin-bottom: 12px; 
      line-height: 1.3; 
    }
    .study-desc { 
      font-size: 0.9rem; 
      color: #6a7a90; 
      line-height: 1.5; 
    }

    /* Footer */
    .footer { 
      text-align: center; 
      padding: 50px 24px; 
      font-size: 0.85rem; 
      color: #3a4a5a; 
      border-top: 1px solid #151f2e; 
      background: #040810; 
    }
    .footer a { 
      color: #4a8fe7; 
      text-decoration: none; 
    }
    .footer a:hover { 
      text-decoration: underline; 
    }
    .disclaimer { 
      max-width: 600px; 
      margin: 16px auto 0; 
      color: #2a3a4a; 
      font-size: 0.75rem; 
      line-height: 1.5; 
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero h1 { font-size: 2.2rem; }
      .hero { padding: 70px 20px 50px; }
      .section-container { padding: 40px 20px; }
      .studies-grid { 
        grid-template-columns: 1fr; 
        gap: 20px; 
      }
      .study-card { padding: 24px 20px; }
      .stat-number { font-size: 2rem; }
    }
  </style>
</head>
<body>
  <Nav />
  <!-- Hero -->
  <div class="hero">
    <div class="hero-content">
      <div class="tagline">Independent Equity Research</div>
      <h1>Westmount Fundamentals</h1>
      <p>Data-driven market analysis. PEG ratios, dividend fundamentals, sector valuations, and broker comparisons — no fluff, no paywalls.</p>
    </div>
  </div>

  <!-- Tools Section -->
  {tools.length > 0 && (
    <div class="section-container" id="tools">
      <div class="section-header">
        <span class="section-tag">🛠️ TOOLS</span>
        <h2 class="section-title">Calculators & Tools</h2>
        <p class="section-sub">Interactive financial calculators and market simulators.</p>
      </div>
      <div class="studies-grid">
        {tools.map(tool => (
          <a class="study-card" href={tool.slug}>
            {tool.emoji && <span class="study-emoji">{tool.emoji}</span>}
            {tool.tag && <span class="study-tag" style="display:inline-block; font-size:0.7rem; font-weight:800; color:#4a8fe7; background:rgba(74,143,231,0.1); padding:4px 8px; border-radius:4px; margin-bottom:12px;">{tool.tag}</span>}
            <div class="study-stat">
              <span class="stat-number">{tool.stat}</span>
              <span class="stat-label">{tool.statLabel}</span>
            </div>
            <h3 class="study-name">{tool.title || tool.name}</h3>
            {tool.subtitle && <p style="font-size:0.85rem; color:#4a8fe7; margin-bottom:8px;">{tool.subtitle}</p>}
            <p class="study-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Studies Section -->
  {studies.length > 0 && (
    <div class="section-container" id="studies">
      <div class="section-header">
        <span class="section-tag">📊 RESEARCH</span>
        <h2 class="section-title">Studies</h2>
        <p class="section-sub">Original data. Crawled, compiled, ranked.</p>
      </div>
      <div class="studies-grid">
        {studies.map(study => (
          <a class="study-card" href={study.slug}>
            {study.emoji && <span class="study-emoji">{study.emoji}</span>}
            {study.tag && <span class="study-tag" style="display:inline-block; font-size:0.7rem; font-weight:800; color:#4a8fe7; background:rgba(74,143,231,0.1); padding:4px 8px; border-radius:4px; margin-bottom:12px;">{study.tag}</span>}
            <div class="study-stat">
              <span class="stat-number">{study.stat}</span>
              <span class="stat-label">{study.statLabel}</span>
            </div>
            <h3 class="study-name">{study.title || study.name}</h3>
            {study.subtitle && <p style="font-size:0.85rem; color:#4a8fe7; margin-bottom:8px;">{study.subtitle}</p>}
            <p class="study-desc">{study.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Guides Section -->
  {guides.length > 0 && (
    <div class="section-container" id="guides">
      <div class="section-header">
        <span class="section-tag" style="background:rgba(231,143,74,0.1); color:#e78f4a;">📚 EDUCATION</span>
        <h2 class="section-title">Guides</h2>
        <p class="section-sub">Comprehensive explainers and methodologies.</p>
      </div>
      <div class="studies-grid">
        {guides.map(guide => (
          <a class="study-card" href={guide.slug} style="border-top: 2px solid #e78f4a;">
            {guide.emoji && <span class="study-emoji">{guide.emoji}</span>}
            {guide.tag && <span class="study-tag" style="display:inline-block; font-size:0.7rem; font-weight:800; color:#e78f4a; background:rgba(231,143,74,0.1); padding:4px 8px; border-radius:4px; margin-bottom:12px;">{guide.tag}</span>}
            <div class="study-stat">
              <span class="stat-number" style="color:#e78f4a;">{guide.stat}</span>
              <span class="stat-label">{guide.statLabel}</span>
            </div>
            <h3 class="study-name">{guide.title || guide.name}</h3>
            {guide.subtitle && <p style="font-size:0.85rem; color:#e78f4a; margin-bottom:8px;">{guide.subtitle}</p>}
            <p class="study-desc">{guide.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Footer -->
  <div class="footer">
    © 2026 <a href="/">westmount-research</a> · A <a href="https://gab.ae">GAB Ventures</a> property
    <div class="disclaimer">This site provides data and analysis for informational purposes only. Nothing here constitutes investment advice. Do your own research.</div>
  </div>
</body>
</html>