---
import BaseHead from '../layouts/BaseHead.astro';

// Auto-categorize from public/ directory
const tools = []; // westmount-research is studies only

const studies = [
  {
    title: "Insider Trading Tracker 2026",
    subtitle: "160 items · Buys & Sells",
    slug: "/insider-trading",
    stat: "$14.7M",
    statLabel: "top insider buying (PAR)",
    desc: "Tracked 160 recent executive buys & sells across the market. Par Technology Corp leads with $14.7M in insider buying. Includes full breakdown of sector activity.",
    tag: "ORIGINAL RESEARCH"
  },
  {
    emoji: "🏢",
    name: "S&P 500 Market Cap Concentration 2026",
    slug: "/market-concentration",
    desc: "Top 10 stocks control 37.3% of the index. Full weight rankings & concentration analysis.",
    stat: "37.3%",
    statLabel: "of S&P 500 in just 10 stocks"
  },
  {
    emoji: "👑",
    name: "Dividend Aristocrats Analysis 2026",
    slug: "/dividend-aristocrats",
    desc: "All 67 S&P 500 companies with 25+ year dividend streaks. Yield, P/E, growth analysis.",
    stat: "67",
    statLabel: "companies with 25yr+ dividend streaks"
  },
  {
    emoji: "🏦",
    name: "Online Broker Fee Comparison 2026",
    slug: "/broker-fees.html",
    desc: "Compare commissions, options fees & margin rates across 22 US/Canada brokers.",
    stat: "22",
    statLabel: "brokers compared"
  },
  {
    emoji: "📈",
    name: "ETF Expense Ratio Index 2026",
    slug: "/etf-expense-ratios",
    desc: "86 major ETFs ranked by true cost. VOO vs SPY vs IVV and 83 more compared.",
    stat: "86",
    statLabel: "ETFs ranked by expense ratio"
  },
  {
    emoji: "🏭",
    name: "Sector P/E Ratios 2026",
    slug: "/sector-pe-ratios.html",
    desc: "All 11 GICS sectors vs 10-year historical average. Which sectors are overvalued?",
    stat: "11",
    statLabel: "GICS sectors analyzed"
  },
  {
    emoji: "📉",
    name: "Most Shorted Stocks 2026",
    slug: "/short-interest.html",
    desc: "76 stocks with 20%+ short interest ranked by % of float. Squeeze candidates & bearish bets.",
    stat: "76",
    statLabel: "heavily shorted stocks ranked"
  },
  {
    emoji: "💰",
    name: "Stock Buyback Leaders 2026",
    slug: "/buyback-leaders",
    desc: "106 companies ranked by share repurchase volume, buyback yield & count reduction.",
    stat: "$709.5B",
    statLabel: "in annual buybacks tracked"
  }
];

const guides = []; // westmount-research is studies only
const lists = []; // westmount-research is studies only
---
<html lang="en">
<head>
  <BaseHead />
  <title>Westmount Research — Independent Equity Research</title>
  <meta name="description" content="Independent equity research. PEG ratios, dividend analysis, broker comparisons, and sector valuations — data-driven, no fluff." />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: 'Inter', -apple-system, sans-serif; 
      background: #060a12; 
      color: #c8d0de; 
      line-height: 1.6;
    }

    /* Hero */
    .hero { 
      text-align: center; 
      padding: 100px 24px 70px; 
      background: linear-gradient(180deg, #0a1628 0%, #060a12 100%); 
      position: relative; 
    }
    .hero::before { 
      content: ''; 
      position: absolute; 
      inset: 0; 
      background: radial-gradient(circle at 50% 40%, rgba(74,143,231,0.08) 0%, transparent 60%); 
    }
    .hero-content { position: relative; z-index: 1; }
    .hero .tagline { 
      color: #4a8fe7; 
      font-size: 0.85rem; 
      font-weight: 700; 
      letter-spacing: 3px; 
      text-transform: uppercase; 
      margin-bottom: 16px; 
    }
    .hero h1 { 
      font-size: 3rem; 
      font-weight: 900; 
      letter-spacing: -1.5px; 
      margin-bottom: 20px; 
      color: #fff; 
    }
    .hero p { 
      color: #5a6a80; 
      font-size: 1.05rem; 
      max-width: 520px; 
      margin: 0 auto; 
    }

    /* Sections */
    .section-container { 
      max-width: 1200px; 
      margin: 0 auto; 
      padding: 60px 24px; 
    }
    .section-header { 
      text-align: center; 
      margin-bottom: 40px; 
    }
    .section-tag { 
      display: inline-block; 
      background: rgba(74,143,231,0.1); 
      color: #4a8fe7; 
      font-size: 0.7rem; 
      font-weight: 800; 
      padding: 6px 16px; 
      border-radius: 20px; 
      letter-spacing: 1px; 
      margin-bottom: 12px; 
    }
    .section-title { 
      font-size: 2.2rem; 
      font-weight: 900; 
      color: #fff; 
      margin-bottom: 8px; 
      letter-spacing: -0.8px; 
    }
    .section-sub { 
      color: #5a6a80; 
      font-size: 1rem; 
    }

    /* Studies Grid */
    .studies-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); 
      gap: 24px; 
    }
    .study-card { 
      background: linear-gradient(135deg, #0a1020 0%, #0d1428 100%); 
      border: 1px solid #1a2332; 
      border-radius: 16px; 
      padding: 32px 28px; 
      text-decoration: none; 
      color: inherit; 
      display: block; 
      transition: all 0.3s ease; 
      position: relative; 
      overflow: hidden; 
    }
    .study-card::before { 
      content: ''; 
      position: absolute; 
      top: 0; 
      left: 0; 
      right: 0; 
      height: 2px; 
      background: linear-gradient(90deg, #4a8fe7, #6ba3f0); 
      opacity: 0; 
      transition: opacity 0.3s; 
    }
    .study-card:hover { 
      border-color: #4a8fe7; 
      transform: translateY(-4px); 
      box-shadow: 0 12px 40px rgba(74,143,231,0.15); 
    }
    .study-card:hover::before { opacity: 1; }
    
    .study-emoji { 
      font-size: 1.8rem; 
      margin-bottom: 16px; 
      display: block; 
    }
    .study-subtitle {
      font-size: 0.8rem;
      font-weight: 700;
      color: #4a8fe7;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 16px;
      display: block;
    }
    .study-stat { 
      margin-bottom: 16px; 
    }
    .stat-number { 
      display: block; 
      font-size: 2.4rem; 
      font-weight: 900; 
      color: #4a8fe7; 
      line-height: 1; 
      letter-spacing: -1px; 
    }
    .stat-label { 
      display: block; 
      font-size: 0.8rem; 
      color: #5a6a80; 
      margin-top: 4px; 
    }
    .study-name { 
      font-size: 1.1rem; 
      font-weight: 800; 
      color: #e0e8f0; 
      margin-bottom: 12px; 
      line-height: 1.3; 
    }
    .study-desc { 
      font-size: 0.9rem; 
      color: #6a7a90; 
      line-height: 1.5; 
    }

    /* Footer */
    .footer { 
      text-align: center; 
      padding: 50px 24px; 
      font-size: 0.85rem; 
      color: #3a4a5a; 
      border-top: 1px solid #151f2e; 
      background: #040810; 
    }
    .footer a { 
      color: #4a8fe7; 
      text-decoration: none; 
    }
    .footer a:hover { 
      text-decoration: underline; 
    }
    .disclaimer { 
      max-width: 600px; 
      margin: 16px auto 0; 
      color: #2a3a4a; 
      font-size: 0.75rem; 
      line-height: 1.5; 
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero h1 { font-size: 2.2rem; }
      .hero { padding: 70px 20px 50px; }
      .section-container { padding: 40px 20px; }
      .studies-grid { 
        grid-template-columns: 1fr; 
        gap: 20px; 
      }
      .study-card { padding: 24px 20px; }
      .stat-number { font-size: 2rem; }
    }
  </style>
</head>
<body>
  <!-- Hero -->
  <div class="hero">
    <div class="hero-content">
      <div class="tagline">Independent Equity Research</div>
      <h1>Westmount Research</h1>
      <p>Data-driven market analysis. PEG ratios, dividend fundamentals, sector valuations, and broker comparisons — no fluff, no paywalls.</p>
    </div>
  </div>

  <!-- Studies Section -->
  {studies.length > 0 && (
    <div class="section-container">
      <div class="section-header">
        <span class="section-tag">📊 RESEARCH</span>
        <h2 class="section-title">Studies</h2>
        <p class="section-sub">Original data. Crawled, compiled, ranked.</p>
      </div>
      <div class="studies-grid">
        {studies.map(study => (
          <a class="study-card" href={study.slug}>
            {study.emoji && <span class="study-emoji">{study.emoji}</span>}
            {study.subtitle && <span class="study-subtitle">{study.subtitle}</span>}
            <div class="study-stat">
              <span class="stat-number">{study.stat}</span>
              <span class="stat-label">{study.statLabel}</span>
            </div>
            <h3 class="study-name">{study.name || study.title}</h3>
            <p class="study-desc">{study.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Footer -->
  <div class="footer">
    © 2026 <a href="/">westmount-research</a> · A <a href="https://gab.ae">GAB Ventures</a> property
    <div class="disclaimer">This site provides data and analysis for informational purposes only. Nothing here constitutes investment advice. Do your own research.</div>
  </div>
</body>
</html>