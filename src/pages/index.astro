<html lang="en">
<head>
  <BaseHead />
  <title>Westmount Fundamentals — Independent Equity Research</title>
  <meta name="description" content="Independent equity research. PEG ratios, dividend analysis, broker comparisons, and sector valuations — data-driven, no fluff." />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: 'Inter', -apple-system, sans-serif; 
      background: #060a12; 
      color: #c8d0de; 
      line-height: 1.6;
    }

    /* Hero */
    .hero { 
      text-align: center; 
      padding: 100px 24px 70px; 
      background: linear-gradient(180deg, #0a1628 0%, #060a12 100%); 
      position: relative; 
    }
    .hero::before { 
      content: ''; 
      position: absolute; 
      inset: 0; 
      background: radial-gradient(circle at 50% 40%, rgba(74,143,231,0.08) 0%, transparent 60%); 
    }
    .hero-content { position: relative; z-index: 1; }
    .hero .tagline { 
      color: #4a8fe7; 
      font-size: 0.85rem; 
      font-weight: 700; 
      letter-spacing: 3px; 
      text-transform: uppercase; 
      margin-bottom: 16px; 
    }
    .hero h1 { 
      font-size: 3rem; 
      font-weight: 900; 
      letter-spacing: -1.5px; 
      margin-bottom: 20px; 
      color: #fff; 
    }
    .hero p { 
      color: #5a6a80; 
      font-size: 1.05rem; 
      max-width: 520px; 
      margin: 0 auto; 
    }

    /* Sections */
    .section-container { 
      max-width: 1200px; 
      margin: 0 auto; 
      padding: 60px 24px; 
    }
    .section-header { 
      text-align: center; 
      margin-bottom: 40px; 
    }
    .section-tag { 
      display: inline-block; 
      background: rgba(74,143,231,0.1); 
      color: #4a8fe7; 
      font-size: 0.7rem; 
      font-weight: 800; 
      padding: 6px 16px; 
      border-radius: 20px; 
      letter-spacing: 1px; 
      margin-bottom: 12px; 
    }
    .section-title { 
      font-size: 2.2rem; 
      font-weight: 900; 
      color: #fff; 
      margin-bottom: 8px; 
      letter-spacing: -0.8px; 
    }
    .section-sub { 
      color: #5a6a80; 
      font-size: 1rem; 
    }

    /* Studies Grid */
    .studies-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); 
      gap: 24px; 
    }
    .study-card { 
      background: linear-gradient(135deg, #0a1020 0%, #0d1428 100%); 
      border: 1px solid #1a2332; 
      border-radius: 16px; 
      padding: 32px 28px; 
      text-decoration: none; 
      color: inherit; 
      display: block; 
      transition: all 0.3s ease; 
      position: relative; 
      overflow: hidden; 
    }
    .study-card::before { 
      content: ''; 
      position: absolute; 
      top: 0; 
      left: 0; 
      right: 0; 
      height: 2px; 
      background: linear-gradient(90deg, #4a8fe7, #6ba3f0); 
      opacity: 0; 
      transition: opacity 0.3s; 
    }
    .study-card:hover { 
      border-color: #4a8fe7; 
      transform: translateY(-4px); 
      box-shadow: 0 12px 40px rgba(74,143,231,0.15); 
    }
    .study-card:hover::before { opacity: 1; }
    
    .study-emoji { 
      font-size: 1.8rem; 
      margin-bottom: 16px; 
      display: block; 
    }
    .study-stat { 
      margin-bottom: 16px; 
    }
    .stat-number { 
      display: block; 
      font-size: 2.4rem; 
      font-weight: 900; 
      color: #4a8fe7; 
      line-height: 1; 
      letter-spacing: -1px; 
    }
    .stat-label { 
      display: block; 
      font-size: 0.8rem; 
      color: #5a6a80; 
      margin-top: 4px; 
    }
    .study-name { 
      font-size: 1.1rem; 
      font-weight: 800; 
      color: #e0e8f0; 
      margin-bottom: 12px; 
      line-height: 1.3; 
    }
    .study-desc { 
      font-size: 0.9rem; 
      color: #6a7a90; 
      line-height: 1.5; 
    }

    /* Footer */
    .footer { 
      text-align: center; 
      padding: 50px 24px; 
      font-size: 0.85rem; 
      color: #3a4a5a; 
      border-top: 1px solid #151f2e; 
      background: #040810; 
    }
    .footer a { 
      color: #4a8fe7; 
      text-decoration: none; 
    }
    .footer a:hover { 
      text-decoration: underline; 
    }
    .disclaimer { 
      max-width: 600px; 
      margin: 16px auto 0; 
      color: #2a3a4a; 
      font-size: 0.75rem; 
      line-height: 1.5; 
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero h1 { font-size: 2.2rem; }
      .hero { padding: 70px 20px 50px; }
      .section-container { padding: 40px 20px; }
      .studies-grid { 
        grid-template-columns: 1fr; 
        gap: 20px; 
      }
      .study-card { padding: 24px 20px; }
      .stat-number { font-size: 2rem; }
    }
  </style>
</head>
<body>
  <Nav />
  <!-- Hero -->
  <div class="hero">
    <div class="hero-content">
      <div class="tagline">Independent Equity Research</div>
      <h1>Westmount Fundamentals</h1>
      <p>Data-driven market analysis. PEG ratios, dividend fundamentals, sector valuations, and broker comparisons — no fluff, no paywalls.</p>
    </div>
  </div>

  <!-- Tools Section -->
  {tools.length > 0 && (
    <div class="section-container" id="tools">
      <div class="section-header">
        <span class="section-tag">🛠️ TOOLS</span>
        <h2 class="section-title">Calculators & Tools</h2>
        <p class="section-sub">Interactive financial calculators and market simulators.</p>
      </div>
      <div class="studies-grid">
        {tools.map(tool => (
          <a class="study-card" href={tool.slug}>
            {tool.emoji && <span class="study-emoji">{tool.emoji}</span>}
            {tool.tag && <span class="study-tag" style="display:inline-block; font-size:0.7rem; font-weight:800; color:#4a8fe7; background:rgba(74,143,231,0.1); padding:4px 8px; border-radius:4px; margin-bottom:12px;">{tool.tag}</span>}
            <div class="study-stat">
              <span class="stat-number">{tool.stat}</span>
              <span class="stat-label">{tool.statLabel}</span>
            </div>
            <h3 class="study-name">{tool.title || tool.name}</h3>
            {tool.subtitle && <p style="font-size:0.85rem; color:#4a8fe7; margin-bottom:8px;">{tool.subtitle}</p>}
            <p class="study-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Studies Section -->
  {studies.length > 0 && (
    <div class="section-container" id="studies">
      <div class="section-header">
        <span class="section-tag">📊 RESEARCH</span>
        <h2 class="section-title">Studies</h2>
        <p class="section-sub">Original data. Crawled, compiled, ranked.</p>
      </div>
      <div class="studies-grid">
        {studies.map(study => (
          <a class="study-card" href={study.slug}>
            {study.emoji && <span class="study-emoji">{study.emoji}</span>}
            {study.tag && <span class="study-tag" style="display:inline-block; font-size:0.7rem; font-weight:800; color:#4a8fe7; background:rgba(74,143,231,0.1); padding:4px 8px; border-radius:4px; margin-bottom:12px;">{study.tag}</span>}
            <div class="study-stat">
              <span class="stat-number">{study.stat}</span>
              <span class="stat-label">{study.statLabel}</span>
            </div>
            <h3 class="study-name">{study.title || study.name}</h3>
            {study.subtitle && <p style="font-size:0.85rem; color:#4a8fe7; margin-bottom:8px;">{study.subtitle}</p>}
            <p class="study-desc">{study.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Guides Section -->
  {guides.length > 0 && (
    <div class="section-container" id="guides">
      <div class="section-header">
        <span class="section-tag" style="background:rgba(231,143,74,0.1); color:#e78f4a;">📚 EDUCATION</span>
        <h2 class="section-title">Guides</h2>
        <p class="section-sub">Comprehensive explainers and methodologies.</p>
      </div>
      <div class="studies-grid">
        {guides.map(guide => (
          <a class="study-card" href={guide.slug} style="border-top: 2px solid #e78f4a;">
            {guide.emoji && <span class="study-emoji">{guide.emoji}</span>}
            {guide.tag && <span class="study-tag" style="display:inline-block; font-size:0.7rem; font-weight:800; color:#e78f4a; background:rgba(231,143,74,0.1); padding:4px 8px; border-radius:4px; margin-bottom:12px;">{guide.tag}</span>}
            <div class="study-stat">
              <span class="stat-number" style="color:#e78f4a;">{guide.stat}</span>
              <span class="stat-label">{guide.statLabel}</span>
            </div>
            <h3 class="study-name">{guide.title || guide.name}</h3>
            {guide.subtitle && <p style="font-size:0.85rem; color:#e78f4a; margin-bottom:8px;">{guide.subtitle}</p>}
            <p class="study-desc">{guide.desc}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Footer -->
  <div class="footer">
    © 2026 <a href="/">westmount-research</a> · A <a href="https://gab.ae">GAB Ventures</a> property
    <div class="disclaimer">This site provides data and analysis for informational purposes only. Nothing here constitutes investment advice. Do your own research.</div>
  </div>
</body>
</html>